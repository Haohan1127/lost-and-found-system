# PowerShell 中使用 $env:变量名="值" 设置；本工程不自动读取 .env。
DJANGO_DEBUG=1
DJANGO_DEMO_MODE=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 非调试环境必须配置随机密钥，同时关闭演示适配接口。
DJANGO_SECRET_KEY=replace-for-deployment
# 限流开关（默认开启；本地调试可设为 0 关闭）。
DJANGO_RATE_LIMIT=1
# 演示校园身份固定绑定码（仅演示/验收使用，不提交真实值；留空则自动随机生成）。
DEMO_BINDING_CODE=replace-with-local-demo-code
